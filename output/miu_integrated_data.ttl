miu:studentID a owl:DatatypeProperty ;
    rdfs:domain miu:Student ;
    rdfs:range xsd:integer .

miu:tuitionFee a owl:DatatypeProperty ;
    rdfs:domain miu:FeeRecord ;
    rdfs:range xsd:decimal .

miu:university a miu:University ;
    miu:hasDepartment <http://www.miu.ac.ke/ontology/university#department/Business>,
        <http://www.miu.ac.ke/ontology/university#department/Communication>,
        <http://www.miu.ac.ke/ontology/university#department/Computing> ;
    miu:universityName "Meridian International University"^^xsd:string .

miu:universityName a owl:DatatypeProperty ;
    rdfs:domain miu:University ;
    rdfs:range xsd:string .

<http://www.miu.ac.ke/ontology/university#course/BUS201> a miu:Course ;
    miu:courseCode "BUS201"^^xsd:string ;
    miu:courseName "Principles of Management"^^xsd:string .

<http://www.miu.ac.ke/ontology/university#course/BUS202> a miu:Course ;
    miu:courseCode "BUS202"^^xsd:string ;
    miu:courseName "Business Research Methods"^^xsd:string .

<http://www.miu.ac.ke/ontology/university#course/COM101> a miu:Course ;
    miu:courseCode "COM101"^^xsd:string ;
    miu:courseName "Introduction to Communication"^^xsd:string .

<http://www.miu.ac.ke/ontology/university#course/CS101> a miu:Course ;
    miu:courseCode "CS101"^^xsd:string ;
    miu:courseName "Introduction to Programming"^^xsd:string .

<http://www.miu.ac.ke/ontology/university#course/CS102> a miu:Course ;
    miu:courseCode "CS102"^^xsd:string ;
    miu:courseName "Database Systems"^^xsd:string .

<http://www.miu.ac.ke/ontology/university#enrolment/1001_CS101> a miu:Enrolment ;
    miu:isForCourse <http://www.miu.ac.ke/ontology/university#course/CS101> .

<http://www.miu.ac.ke/ontology/university#enrolment/1002_BUS201> a miu:Enrolment ;
    miu:isForCourse <http://www.miu.ac.ke/ontology/university#course/BUS201> .

<http://www.miu.ac.ke/ontology/university#enrolment/1003_CS102> a miu:Enrolment ;
    miu:isForCourse <http://www.miu.ac.ke/ontology/university#course/CS102> .

<http://www.miu.ac.ke/ontology/university#enrolment/1004_COM101> a miu:Enrolment ;
    miu:isForCourse <http://www.miu.ac.ke/ontology/university#course/COM101> .

<http://www.miu.ac.ke/ontology/university#enrolment/1005_BUS202> a miu:Enrolment ;
    miu:isForCourse <http://www.miu.ac.ke/ontology/university#course/BUS202> .

