miu:firstName a owl:DatatypeProperty ;
    rdfs:domain miu:Student ;
    rdfs:range xsd:string .

<http://www.miu.ac.ke/ontology/university#department/Communication> a miu:Department ;
    miu:departmentName "Communication"^^xsd:string .

miu:University a owl:Class .

<http://www.miu.ac.ke/ontology/university#department/Business> a miu:Department ;
    miu:departmentName "Business"^^xsd:string .

<http://www.miu.ac.ke/ontology/university#department/Computing> a miu:Department ;
    miu:departmentName "Computing"^^xsd:string .

miu:Department a owl:Class .

miu:Enrolment a owl:Class .

miu:Course a owl:Class .

miu:FeeRecord a owl:Class .

miu:Student a owl:Class .

[] a owl:AllDisjointProperties ;
    owl:members ( miu:firstName ) .

