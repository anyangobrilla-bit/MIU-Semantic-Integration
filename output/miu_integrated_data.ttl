@prefix miu: <http://www.miu.ac.ke/ontology/university#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.miu.ac.ke/ontology/university> a owl:Ontology .

miu:admissionDate a owl:DatatypeProperty ;
    rdfs:domain miu:Student ;
    rdfs:range xsd:dateTime .

miu:amountPaid a owl:DatatypeProperty ;
    rdfs:domain miu:FeeRecord ;
    rdfs:range xsd:decimal .

miu:belongsToDepartment a owl:ObjectProperty ;
    rdfs:domain miu:Student ;
    rdfs:range miu:Department .

miu:courseCode a owl:DatatypeProperty ;
    rdfs:domain miu:Course ;
    rdfs:range xsd:string .

miu:courseName a owl:DatatypeProperty ;
    rdfs:domain miu:Course ;
    rdfs:range xsd:string .

miu:departmentName a owl:DatatypeProperty ;
    rdfs:domain miu:Department ;
    rdfs:range xsd:string .

miu:hasDepartment a owl:ObjectProperty ;
    rdfs:domain miu:University ;
    rdfs:range miu:Department .

miu:hasEnrolment a owl:ObjectProperty ;
    rdfs:domain miu:Student ;
    rdfs:range miu:Enrolment .

miu:hasFeeRecord a owl:ObjectProperty ;
    rdfs:domain miu:Student ;
    rdfs:range miu:FeeRecord .

miu:isForCourse a owl:ObjectProperty ;
    rdfs:domain miu:Enrolment ;
    rdfs:range miu:Course .

miu:lastName a owl:DatatypeProperty ;
    rdfs:domain miu:Student ;
    rdfs:range xsd:string .

miu:offersCourse a owl:ObjectProperty ;
    rdfs:domain miu:Department ;
    rdfs:range miu:Course .

miu:outstandingBalance a owl:DatatypeProperty ;
    rdfs:domain miu:FeeRecord ;
    rdfs:range xsd:decimal .

